# FreeCAD "exploded" document scratch directory (same name as a tracked .FCStd) —
# mesh-kernel cache, thumbnails, and appearance cache, regenerable on next open.
NBF_RADO-SCS/
*.FCBak

# Kept locally for Claude Code / HPC operational notes, deliberately not published
# (repo is public; CLAUDE.md was stripped from history — see git-filter-repo run)
CLAUDE.md

# Raw MAPDL slice exports are large and regenerable from the .rst on Pioneer
src/ansys/**/results/*_slice.csv

# Pre-label snapshot of the FreeCAD document taken by src/freecad/apply_labels.py
# before it rewrites any Label (25 MB, and the .FCStd itself is tracked)
*.prelabel*.bak

# Same idea for the other document-rewriting scripts: apply_colors.py takes a
# .precolor.bak before it repaints. (.prelead.bak was make_lead_variants.py's,
# which no longer exists -- see below -- but old ones may still be on disk.)
*.precolor*.bak
*.prelead*.bak

# Regenerable run reports from the src/freecad/ document scripts
src/freecad/apply_labels_report.txt
src/freecad/apply_colors_report*.txt
src/freecad/build_lead_config_report.txt
src/freecad/drop_rado_lead_report.txt
src/freecad/test_regression_report.txt
src/freecad/foramen_report.txt

# THERE IS ONE MODEL DOCUMENT: NBF_RADO-SCS.FCStd, holding anatomy only.
#
# NBF_RADO-SCS_dorsal.FCStd and _ventral.FCStd used to be tracked here, one per
# arm of the dorsal-vs-ventral study, built by make_lead_variants.py. They are
# gone, and so is that script. A lead is no longer baked into a copy of the
# document: it is a handful of parameters plus a directory of STLs under
# src/freecad/generated_leads/, previewed into the open document on demand and
# thrown away. generated_leads/dorsal_z110_8c/ and ventral_z110_8c/ are what
# those two documents contained, and src/freecad/test_regression.py rebuilds
# them from their parameters and compares every byte.
#
# Their exploded scratch directories are still ignored in case an old checkout
# has them lying about, matching the NBF_RADO-SCS/ rule at the top.
NBF_RADO-SCS_dorsal/
NBF_RADO-SCS_ventral/

# Python bytecode from the src/ansys/ helper scripts
__pycache__/
*.pyc

# NEURON's virtual environment and the mechanisms nrnivmodl compiles from the
# .mod files -- both are rebuilt by the install steps in src/neuron/README.md
src/neuron/.venv/
src/neuron/x86_64/
src/neuron/**/x86_64/

# Pre-grouping snapshot from src/freecad/make_tissue_groups.py
*.pregroup*.bak
src/freecad/make_tissue_groups_report*.txt

# fem/ -- the FreeCAD-side FEM route. Scripts and the write-up are tracked; the
# meshes, solutions and sampled fields are not. They are ~330 MB, regenerable by
# `bash fem/run_all.sh`, and the .msh/.npz/.vtu files in particular are binary
# blobs git would store whole on every change. fem/NBF_RADO-SCS_fem.FCStd is the
# agent's private 24 MB copy of a document already tracked at the repo root.
fem/out/
fem/NBF_RADO-SCS_fem.FCStd
fem/leads/
fem/scripts/__pycache__/

# ---------------------------------------------------------------------------
# Published papers. Kept on disk for reference, never committed: this repo is
# public and these are copyrighted. docs/README.md lists the DOIs instead.
docs/*.pdf

# Lead-variant documents. NBF_RADO-SCS.FCStd (anatomy only) is the one tracked
# model; every variant is reproducible from its Lead Designer parameters, so
# tracking 80 MB binaries per placement buys nothing.
NBF_RADO-SCS_*.FCStd

# The poster itself lives in Box; poster.pptx is a symlink to it and would be a
# dangling link in any clone. Review copies and exports are one-offs.
poster.pptx
poster_review.pdf
poster_assets/
poster_backups/

# Saved HPC node-availability page; a snapshot, not a source file.
hpc_cluster_resource_info.html
AGENTS_log_archive_*.md
docs/abstract*.md
*Research_Day_Abstract*

# FreeCAD backup files from the CAD pilot
*.FCBak
