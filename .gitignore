# FreeCAD "exploded" document scratch directory (same name as a tracked .FCStd) —
# mesh-kernel cache, thumbnails, and appearance cache, regenerable on next open.
NBF_RADO-SCS/
*.FCBak

# Kept locally for Claude Code / HPC operational notes, deliberately not published
# (repo is public; CLAUDE.md was stripped from history — see git-filter-repo run)
CLAUDE.md

# Raw MAPDL slice exports are large and regenerable from the .rst on Pioneer
src/ansys/**/results/*_slice.csv

# Pre-label snapshot of the FreeCAD document taken by src/freecad/apply_labels.py
# before it rewrites any Label (25 MB, and the .FCStd itself is tracked)
*.prelabel*.bak

# Same idea for the other two document-rewriting scripts: apply_colors.py takes
# a .precolor.bak before it repaints, make_lead_variants.py a .prelead.bak
# before it rebuilds a variant on top of an existing one
*.precolor*.bak
*.prelead*.bak

# Regenerable run reports from the src/freecad/ document scripts
src/freecad/apply_labels_report.txt
src/freecad/apply_colors_report*.txt
src/freecad/make_lead_variants_report.txt

# The dorsal/ventral lead variants are DERIVED: base document + the STLs in
# src/freecad/generated_leads/, assembled by make_lead_variants.py in seconds.
# At 25 MB each, and binary (so git stores a whole new copy on every change),
# tracking them would add ~50 MB per revision to a public repo for something one
# command rebuilds. The base NBF_RADO-SCS.FCStd IS tracked -- it is the
# irreplaceable input, hand-built from the STL set and carrying the labels.
#   freecadcmd src/freecad/make_lead_variants.py
NBF_RADO-SCS_dorsal.FCStd
NBF_RADO-SCS_ventral.FCStd
NBF_RADO-SCS_dorsal/
NBF_RADO-SCS_ventral/

# Python bytecode from the src/ansys/ helper scripts
__pycache__/
*.pyc

# NEURON's virtual environment and the mechanisms nrnivmodl compiles from the
# .mod files -- both are rebuilt by the install steps in src/neuron/README.md
src/neuron/.venv/
src/neuron/x86_64/
src/neuron/**/x86_64/

# Pre-grouping snapshot from src/freecad/make_tissue_groups.py
*.pregroup*.bak
src/freecad/make_tissue_groups_report*.txt
