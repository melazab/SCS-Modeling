# FreeCAD "exploded" document scratch directory (same name as a tracked .FCStd) —
# mesh-kernel cache, thumbnails, and appearance cache, regenerable on next open.
NBF_RADO-SCS/
*.FCBak

# Kept locally for Claude Code / HPC operational notes, deliberately not published
# (repo is public; CLAUDE.md was stripped from history — see git-filter-repo run)
CLAUDE.md

# Raw MAPDL slice exports are large and regenerable from the .rst on Pioneer
ansys/**/results/*_slice.csv

# Pre-label snapshot of the FreeCAD document taken by ansys/apply_labels.py
# before it rewrites any Label (25 MB, and the .FCStd itself is tracked)
*.prelabel*.bak

# Regenerable run report from ansys/apply_labels.py
ansys/apply_labels_report.txt

# Python bytecode from the ansys/ helper scripts
__pycache__/
*.pyc
