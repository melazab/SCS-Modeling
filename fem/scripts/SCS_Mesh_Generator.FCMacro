PREVIEW_GROUP_NAME = "SCS_MeshPreviewGroup"
PREVIEW_GROUP_LABEL = "SCS mesh preview (by tissue)"
PREVIEW_PREFIX = "SCS_MeshPreview_"        # + <order name> + "_mesh"
