"""Generate and inspect a mesh for the live FreeCAD lead.

Size controls are in mm and apply to the entire anatomical domain. The
background worker meshes, classifies, checks the dura barrier and publishes a
per-tissue preview. SCS Potential Visualizer owns electrical solving.
Completed artifacts are reused only with matching provenance. Re-running this
macro reloads Python helpers; it never saves the FreeCAD document.
"""
import json
import os
import signal
import sys

import FreeCAD
import FreeCADGui

try:
    from PySide import QtCore, QtGui, QtWidgets
except ImportError:                                     # pragma: no cover
    try:
        from PySide6 import QtCore, QtGui, QtWidgets
    except ImportError:
        from PySide2 import QtCore, QtGui, QtWidgets

