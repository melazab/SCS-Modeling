# Macro/) to appear in the Macro menu/toolbar, and __file__ then points
# THERE, not at fem/scripts/ -- deriving the repo root from it silently
# computed a bogus venv path the one time this was tried from a copy. A
# symlink wouldn't have helped either: os.path.abspath() doesn't resolve
# symlinks. NEVER hard-link this file into the Macro directory -- always a
# symlink (`ln -s`); a hard link silently desyncs from any editor that saves
# by writing a new file and renaming it over the old one.
REPO_ROOT = "/home/mohamed/Projects/SCS-Modeling"
FEM_SCRIPTS_DIR = os.path.join(REPO_ROOT, "fem", "scripts")
sys.path.insert(0, FEM_SCRIPTS_DIR)
import async_runner
import build_mesh
