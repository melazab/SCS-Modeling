        form.addRow("Colour clamp (0=auto)", self.clamp_spin)
        mv.addLayout(form)

        waveform = QtWidgets.QGroupBox('Waveform and phase snapshots')
        wf = QtWidgets.QFormLayout(waveform)
        self.wave_mode = QtWidgets.QComboBox()
        self.wave_mode.addItems(['Static', 'FAST-style biphasic'])
        self.wave_mode.setCurrentText(str(self.montage_obj.WaveformMode))
        wf.addRow('Mode', self.wave_mode)
        self.wave_spins = {}
        for prop, label, low, high, suffix in (
            ('FrequencyHz', 'Frequency', .01, 10000., ' Hz'),
            ('PhaseWidthUs', 'Width per phase', 1., 100000., ' µs'),
            ('InterphaseGapUs', 'Gap (assumption)', 0., 100000., ' µs')):
            spin = QtWidgets.QDoubleSpinBox()
            spin.setRange(low, high)
            spin.setDecimals(2)
            spin.setSuffix(suffix)
            spin.setValue(getattr(self.montage_obj, prop))
            self.wave_spins[prop] = spin
            wf.addRow(label, spin)
        self.phase_choice = QtWidgets.QComboBox()
        self.phase_choice.addItems(['First phase', 'Reverse phase', 'Interpulse interval'])
        wf.addRow('Snapshot phase', self.phase_choice)
        self.phase_choice.currentIndexChanged.connect(lambda *_: self.apply_montage())
        apply_phase = QtWidgets.QPushButton('Update phase / currents (cached field)')
        apply_phase.clicked.connect(self.apply_montage)
        wf.addRow(apply_phase)
        viewer = QtWidgets.QPushButton('Export animation + PNG snapshot viewer…')
        viewer.clicked.connect(self.export_fast_viewer)
        wf.addRow(viewer)
        note = QtWidgets.QLabel('90 Hz, symmetric active recharge. 220 µs is the common comparison default. Gap=0 is assumed. Field-only visualization; not a perception or efficacy prediction.')
        note.setWordWrap(True)
        wf.addRow(note)
        mv.addWidget(waveform)

        self.background_check = QtWidgets.QCheckBox("Include background tissue")
        self.background_check.setChecked(self.montage_obj.IncludeBackground)
        self.background_check.setToolTip(
            "Include mesh elements outside the classified anatomy/lead as a conducting "
            "background at bone conductivity. Off removes those elements from the solve. "
            "This changes the solved field and memory use, not tissue visibility; "
            "each setting has a separate solution cache.")
        self.background_check.toggled.connect(
            lambda checked: setattr(self.montage_obj, 'IncludeBackground', checked))
        self.background_check.toggled.connect(self.refresh_gates)
        mv.addWidget(self.background_check)
        self.local_group = QtWidgets.QGroupBox('Execution')
        local_form = QtWidgets.QVBoxLayout(self.local_group)
        self.execution_status = QtWidgets.QLabel()
        local_form.addWidget(self.execution_status)
        manager = QtWidgets.QPushButton('Open Job Manager…')
        manager.clicked.connect(lambda: __import__('scs_job_manager').show())
        local_form.addWidget(manager)
        mv.addWidget(self.local_group)
        self.solve_detail = QtWidgets.QPlainTextEdit()
        self.solve_detail.setReadOnly(True)
        self.solve_detail.document().setMaximumBlockCount(200)
        self.solve_runner.stage_message.connect(self.solve_detail.appendPlainText)
        self.solve_detail.setMaximumHeight(100)
        mv.addWidget(self.solve_detail)

        row = QtWidgets.QHBoxLayout()
        self.btn_plot = QtWidgets.QPushButton("Solve / Plot Field")
        self.btn_plot.setToolTip(
            "Solve the completed mesh from SCS Mesh Generator, then plot the "
            "contact currents. Changing only currents reuses the basis fields.")
        self.btn_plot.clicked.connect(self.start_plot)
        row.addWidget(self.btn_plot, 1)
        self.btn_plot_abort = QtWidgets.QPushButton("Abort")
        self.btn_plot_abort.setEnabled(False)
        self.btn_plot_abort.setToolTip(
            "Kills the solve subprocess currently "
            "running for this Plot Field press, and verifies it actually "
            "exited.")
        self.btn_plot_abort.clicked.connect(self.abort_plot)
        row.addWidget(self.btn_plot_abort, 1)
        mv.addLayout(row)

        self.plot_progress = QtWidgets.QProgressBar()
        self.plot_progress.setRange(0, 100)
        self.plot_progress.setValue(0)
        self.plot_progress.setFormat("%p%")
        mv.addWidget(self.plot_progress)

        self.status = QtWidgets.QLabel("")
        self.status.setAlignment(QtCore.Qt.AlignCenter)
        self.status.setMinimumHeight(24)
        self.status.setWordWrap(True)
        self.status.setSizePolicy(QtWidgets.QSizePolicy.Ignored, QtWidgets.QSizePolicy.Preferred)
        mv.addWidget(self.status)
        async_runner.set_status(self.status, "idle", "Not plotted yet this session")

        readout_form = QtWidgets.QFormLayout()
        self.clamp_label = QtWidgets.QLabel("-")
        readout_form.addRow("Clamp shown", self.clamp_label)
